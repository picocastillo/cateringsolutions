
<% page title: 'Ver Pedidos Cocina', raiz: 'Pedidos', hojas: 'Ver Pedidos Cocina', acciones: [link_to('Nuevo', new_pedido_cocina_path)].compact, id: 'index-pedidos-cocina' %>

  <div class="row">
    <div class="col-12">
      <div id="<%= 'daily-orders-container' if current_user.admin? && tienda_activa.carrito_de_compras %>" class="col-12"  style="padding: 0px;">
        <%= render '/inicio/daily_orders' %>
      </div>

      <div class="card filtros">
        <div class="bg-info" >
          <h4 class="text-white card-title">Filtros<div class="card-actions">
              <a class="" data-action="collapse"><i class="<%= @filtro_abierto ? 'ti-minus' : 'ti-plus' %>"></i></a>
              <a class="btn-close" data-action="close"><i class="ti-close"></i></a>
          </div>
        </h4>
        </div>
        <div class="card-body collapse<%= ' show' if @filtro_abierto %>">
          <%= error_messages_for @query %>
          <%= query_form_for @query, remote: true do |f| %>
            <%= f.input :codigo, input_html: { autocomplete: 'off' } %>
            <%= f.input :fecha_desde, as: :string, required: false, input_html: { class: 'singledate', autocomplete: 'off' } %>
            <%= f.input :fecha_hasta, as: :string, required: false, input_html: { class: 'singledate', autocomplete: 'off' } %>
            <%= f.input :cliente_ids, label: 'Clientes', as: :select2, input_html: {data: {multiple: true, url: clientes_path(format: :json), pre: @query.cliente_ids.presence && Clientes::Cliente.where(id: @query.cliente_ids.split(',').map(&:to_i))}, autocomplete: 'off'}  unless current_user.cliente? %>
            <%= f.input :cuenta_ids, label: 'Cuentas', as: :select2, input_html: {data: {multiple: true, minimum_input_length: 1, label: 'cliente_y_nombre', selection: 'cliente_y_nombre', url: cuentas_path(format: :json), pre: @query.cuenta_ids.presence && Clientes::Cuenta.where(id: @query.cuenta_ids.split(',').map(&:to_i))}, autocomplete: 'off'} if current_user.cumple_rol?(:administrador_empresa) || !current_user.cliente? %>
            <%= f.input :usuario_ids, label: 'Usuarios', as: :select2, input_html: {data: {multiple: true, url: usuarios_path(format: :json), pre: @query.usuario_ids.presence && Usuarios::Usuario.where(id: @query.usuario_ids)}, autocomplete: 'off'} if current_user.cumple_rol?(:administrador_empresa) || !current_user.cliente? %>
            <%= f.input :estado_id, label: 'Estado', as: :select, collection: [Pedidos::Estado[:aceptado], Pedidos::Estado[:confirmado], Pedidos::Estado[:cancelado]] , label_method: :desc, include_blank: true, input_html: { autocomplete: 'off' } %>
            <%= f.input :horarios_de_corte_ids, as: :select2_local, collection: Clientes::Cuenta.horarios_corte_efectivos(tienda_activa.id), selected: @query.horarios_de_corte_ids, label: 'Hora de Corte', label_method: :to_s, include_blank: true, input_html: {multiple: true, autocomplete: 'off'}, wrapper_html: { class: "col-sm-9 col-md-4 mb-0"} unless current_user.cliente? %>
            <%= search_buttons f %>
          <% end %>
        </div>
      </div>
      <div class="card" id="listado-pedidos">
          <div class="card-header">
              <div class="card-actions">
                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
          <span id="pedidos-container">
            <%= render 'resultados' %>
          </span>
      </div>
  </div>
</div>
