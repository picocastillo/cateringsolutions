<% content_for :styles do %>
  @page {
    size: 50mm 30mm;
    margin: 0;
  }

  body {
    font-family: Calibri;
    text-align: center;
  }
<% end %>

<% page id: 'cupones-etiquetas' %>
<% primero = true %>
<% @cupones.each do |cupon| %>
  <div class="<%= 'page' unless primero %>">
    <%= render partial: 'cupon_ticket', locals: { cupon: cupon } %>
  </div>
  <% primero = false %>
<% end %>
