<% content_for :page_id, 'survey-responses-index' %>

<div class="container-fluid mt-4" style="padding-top: 80px">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="col-12 d-flex justify-content-between align-items-center" style="padding: 0.75rem 1.25rem !important;">
          <h4 class="card-title mb-0">
            <i class="fa fa-bar-chart text-info"></i>
            Respuestas de la Encuesta: <%= @survey.title %>
          </h4>
          <div class="btn-group">
            <%= link_to new_survey_survey_response_path(@survey), class: 'btn btn-success btn-sm' do %>
              <i class="fa fa-plus"></i>
              Nueva Respuesta
            <% end %>
            <%= link_to survey_path(@survey), class: 'ml-2 btn btn-info btn-sm' do %>
              <i class="fa fa-eye"></i>
              Ver Encuesta
            <% end %>
            <%= link_to surveys_path, class: 'ml-2 btn btn-secondary btn-sm' do %>
              <i class="fa fa-arrow-left"></i>
              Volver
            <% end %>
          </div>
        </div>
        
        <div class="card-body">
          <!-- Filtros Card -->
          <div class="card filtros mb-4">
            <div class="bg-info">
              <h4 class="text-white card-title">
                Filtros
                <div class="card-actions">
                  <a class="" data-action="collapse"><i class="ti-plus"></i></a>
                  <a class="btn-close" data-action="close"><i class="ti-close"></i></a>
                </div>
              </h4>
            </div>
            <div class="card-body collapse">
              <%= form_with url: survey_survey_responses_path(@survey), method: :get, local: true, class: "row" do |f| %>
                <div class="col-md-8 mb-3">
                  <%= f.text_field :incluye_texto, 
                                 value: @incluye_texto,
                                 placeholder: "Buscar texto en respuestas...",
                                 class: "form-control",
                                 id: "incluye_texto" %>
                  <small class="form-text text-muted">
                    Busca en las respuestas de texto de todas las preguntas
                  </small>
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-start">
                  <%= f.submit "Buscar", class: "btn btn-primary mr-2" %>
                  <% if @incluye_texto.present? %>
                    <%= link_to "Limpiar", survey_survey_responses_path(@survey), class: "btn btn-secondary" %>
                  <% end %>
                </div>
              <% end %>
              
              <% if @incluye_texto.present? %>
                <div class="alert alert-info mb-0">
                  <i class="fa fa-search mr-1"></i>
                  Mostrando respuestas que contienen: <strong>"<%= @incluye_texto %>"</strong>
                  (<%= @survey_responses.count %> resultado<%= @survey_responses.count != 1 ? 's' : '' %>)
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- Survey Summary Stats -->
          <div class="row mb-4">
            <div class="col-md-6">
              <div class="card bg-primary text-white">
                <div class="card-body text-center">
                  <i class="fa fa-users fa-2x mb-2"></i>
                  <h4 style="color:white"><%= @survey_responses.count %></h4>
                  <p class="mb-0">Total Respuestas</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-info text-white">
                <div class="card-body text-center">
                  <i class="fa fa-question-circle fa-2x mb-2"></i>
                  <h4 style="color:white"><%= @survey.questions.count %></h4>
                  <p class="mb-0">Total de Preguntas</p>
                </div>
              </div>
            </div>
          </div>
          
          <% if @survey_responses.any? %>
            <!-- Unified charts summary -->
            <% if @mc_chart_data.present? || @scale_chart_data.present? || @survey.questions.where(question_type: 'text').any? %>
              <div class="mb-4">
                <h5 class="mb-3">
                  <i class="fa fa-bar-chart text-primary"></i>
                  Resultados
                </h5>
                <div class="row">
                  <% @survey.questions.each_with_index do |question, idx| %>
                    <% if question.multiple_choice? %>
                      <% data = @mc_chart_data[question.id] %>
                      <% next unless data %>
                      <% next if Array(data[:series]).map(&:to_i).sum == 0 %>
                      <div class="col-6 mb-3">
                        <div class="card">
                          <div class="card-body">
                            <h6 class="card-title"><span class="badge badge-light mr-2"><%= idx + 1 %></span><%= question.text %></h6>
                            <%= content_tag :span, nil, id: "mc-q-#{question.id}", data: { labels: data[:labels].to_json, datos: data[:series].to_json } %>
                            <canvas id="ct-q-<%= question.id %>" style="height: 220px;"></canvas>
                          </div>
                        </div>
                      </div>
                    <% elsif question.scale? %>
                      <% data = @scale_chart_data[question.id] %>
                      <% next unless data %>
                      <% next if Array(data[:series]).map(&:to_i).sum == 0 %>
                      <div class="col-6 mb-3">
                        <div class="card">
                          <div class="card-body">
                            <h6 class="card-title"><span class="badge badge-light mr-2"><%= idx + 1 %></span><%= question.text %></h6>
                            <%= content_tag :span, nil, id: "scale-q-#{question.id}", data: { labels: data[:labels].to_json, datos: data[:series].to_json } %>
                            <canvas id="scale-ct-q-<%= question.id %>" style="height: 220px;"></canvas>
                          </div>
                        </div>
                      </div>
                    <% elsif question.text? %>
                      <% text_responses = @survey_responses.joins(:question_responses).where(questiones_responses: { question_id: question.id }).includes(:question_responses) %>
                      <% all_text = text_responses.map { |sr| sr.question_responses.find { |qr| qr.question_id == question.id }&.response_text }.compact.join(' ') %>
                      <% next if all_text.blank? %>
                      <div class="col-6 mb-3">
                        <div class="card">
                          <div class="card-body">
                            <h6 class="card-title">
                              <span class="badge badge-light mr-2"><%= idx + 1 %></span>
                              <%= question.text %>
                              <small class="text-muted ml-2">
                                (<%= text_responses.count %> respuesta<%= text_responses.count != 1 ? 's' : '' %>)
                              </small>
                            </h6>
                            <div class="wordcloud-container">
                              <canvas id="wordcloud-<%= question.id %>" style="width: 100%; height: 220px;"></canvas>
                              <span id="text-data-<%= question.id %>" 
                                    data-text="<%= all_text.strip.html_safe %>" 
                                    style="display: none;"></span>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
            
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead class="thead-light">
                  <tr>
                    <th>Usuario</th>
                    <th>Fecha de Inicio</th>
                    <th>Estado</th>
                    <th>Progreso</th>
                    <th>Fecha de Finalización</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @survey_responses.each do |response| %>
                    <tr data-response-id="<%= response.id %>">
                      <td>
                        <strong><%= response.user.nombre %></strong>
                        <br>
                        <small class="text-muted"><%= response.user.email %></small>
                      </td>
                      <td>
                        <span class="text-muted">
                          <%= response.created_at.strftime('%d/%m/%Y %H:%M') %>
                        </span>
                      </td>
                      <td>
                        <% if response.completed? %>
                          <span class="badge badge-success">
                            <i class="fa fa-check-circle"></i>
                            Completada
                          </span>
                        <% else %>
                          <span class="badge badge-warning">
                            <i class="fa fa-clock-o"></i>
                            Pendiente
                          </span>
                        <% end %>
                      </td>
                      <td>
                        <div class="progress" style="height: 20px;">
                          <div class="progress-bar <%= response.completed? ? 'bg-success' : 'bg-warning' %>" 
                               role="progressbar" 
                               style="width: <%= response.progress_percentage %>%"
                               aria-valuenow="<%= response.progress_percentage %>" 
                               aria-valuemin="0" 
                               aria-valuemax="100">
                            <%= response.progress_percentage %>%
                          </div>
                        </div>
                      </td>
                      <td>
                        <% if response.completed? && response.completed_at.present? %>
                          <span class="text-success">
                            <%= response.completed_at.strftime('%d/%m/%Y %H:%M') %>
                          </span>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group" role="group">
                          <%= link_to survey_survey_response_path(@survey, response), 
                                      class: 'btn btn-sm btn-outline-primary',
                                      title: 'Ver respuesta' do %>
                            <i class="fa fa-eye"></i>
                            Ver Detalles
                          <% end %>
                          
                          <% unless response.completed? %>
                            <%= link_to complete_survey_survey_response_path(@survey, response), 
                                        method: :patch,
                                        class: 'btn btn-sm btn-outline-success',
                                        title: 'Marcar como completada',
                                        confirm: '¿Está seguro de marcar esta respuesta como completada?' do %>
                              <i class="fa fa-check"></i>
                            <% end %>
                          <% end %>
                          
                          <% if can?(:destroy, response) %>
                            <%= link_to survey_survey_response_path(@survey, response), 
                                        method: :delete,
                                        class: 'btn btn-sm btn-outline-danger',
                                        title: 'Eliminar respuesta',
                                        confirm: '¿Está seguro de eliminar esta respuesta? Esta acción no se puede deshacer.' do %>
                              <i class="fa fa-trash"></i>
                              Eliminar
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fa fa-bar-chart fa-4x text-muted mb-3"></i>
              <h5 class="text-muted mb-2">Sin respuestas</h5>
              <p class="text-muted mb-3">Esta encuesta aún no tiene respuestas.</p>
              
              <% if @survey.active? && @survey.active_period? && @survey.questions.any? %>
                <%= link_to new_survey_survey_response_path(@survey), class: 'btn btn-primary' do %>
                  <i class="fa fa-plus mr-1"></i>
                  Crear Primera Respuesta
                <% end %>
              <% else %>
                <div class="alert alert-warning d-inline-block">
                  <small>
                    <i class="fa fa-exclamation-triangle mr-1"></i>
                    La encuesta no está disponible para responder.
                    <% unless @survey.active? %>
                      <br>• La encuesta está inactiva
                    <% end %>
                    <% unless @survey.active_period? %>
                      <br>• Fuera del periodo activo
                    <% end %>
                    <% unless @survey.questions.any? %>
                      <br>• Sin preguntas configuradas
                    <% end %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
