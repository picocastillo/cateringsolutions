<%= render partial: 'ventas/facturacion/comprobantes/encabezado', locals: {comprobante: comprobante}, formats: :pdf %>
<%= render 'ventas/facturacion/comprobantes/detalle', comprobante: comprobante, renglones: comprobante.renglones %>

<% pedido = comprobante.pedido %>
<% if pedido && comprobante.factura? && (pedido.tiene_descuento_cupon? || pedido.tiene_descuento_vm?) %>
<table class="datatable mtn mbn" style="width:100%">
  <tbody>
    <tr>
      <td style="width: 70%; font-size: 10px;">Subtotal</td>
      <td style="width: 30%; font-size: 10px;" class="right"><%= number_to_currency(comprobante.total) %></td>
    </tr>
    <tr>
      <td style="width: 70%; font-size: 10px;"><%= pedido.tiene_descuento_vm? ? pedido.descuento_venta_mostrador.nombre : "Cupón #{pedido.cupon.codigo}" %></td>
      <td style="width: 30%; font-size: 10px;" class="right">-<%= number_to_currency(pedido.importe_descuento_total) %></td>
    </tr>
    <tr>
      <td style="width: 70%; font-weight: bold;">Total con Descuento</td>
      <td style="width: 30%; font-weight: bold;" class="right"><%= number_to_currency(pedido.importe_total) %></td>
    </tr>
  </tbody>
</table>
<% end %>

<% if comprobante.pedido&.venta_mostrador? && comprobante.pedido.medios_pago.any? %>
<table class="datatable mtn mbn" style="width:100%">
  <tbody>
    <% comprobante.pedido.medios_pago.each do |mp| %>
      <tr>
        <td style="width: 70%"><%= mp.tipo_label %></td>
        <td style="width: 30%" class="right"><%= number_to_currency(mp.importe) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>

<table id="obs_totales" class="mbn">
  <tr>
    <td>
      <% if pedido && comprobante.factura? && (pedido.tiene_descuento_cupon? || pedido.tiene_descuento_vm?) %>
        <table class="datatable totales">
          <thead><tr><th>Total</th></tr></thead>
          <tbody><tr class="total"><td class="center strong"><%= pedido.importe_total %></td></tr></tbody>
        </table>
      <% else %>
        <%= render partial: 'ventas/facturacion/comprobantes/totales', locals: {comprobante: comprobante}, formats: :html %>
      <% end %>
    </td>
  </tr>
</table>

<table width="100%" class="mtn">
  <tr class="center">
    <%= render 'ventas/facturacion/comprobantes/barcode_pedido', comprobante: comprobante %>
  </tr>
</table>
