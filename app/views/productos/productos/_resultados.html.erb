<div class="card-body collapse show ajax-data-container">
  <div class="table-responsive">
    <%= table_for @productos, id: 'productos' do |t| %>
      <% t.column(:nombre) { |t| link_to discontinuado(t, t.nombre), t } %>
      <% t.column(:categoria, class: 'hidden-md-down') %>
      <% t.column(:codigo, class: 'hidden-md-down')  %>
      <% t.column(:codigos_externos, class: 'hidden-md-down', header: 'Cód. Externos')  %>
      <% t.column(:activo, class: 'center hidden-md-down')  { |t| etiqueta_activo t }%>
      <% t.actions { |t| [edit_link(t, 'Editar'), link_to_activate(t)]} %>
    <% end %>
  </div>
</div>
<%= paginador @productos, ajax: true  %>
