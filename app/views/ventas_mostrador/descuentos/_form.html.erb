<%= modal 'form-modal', title: @descuento.new_record? ? 'Nuevo Descuento Venta Mostrador' : "Editando #{@descuento}" do %>
  <%= simple_form_for @descuento, url: @descuento.new_record? ? ventas_mostrador_descuentos_path : ventas_mostrador_descuento_path(@descuento), remote: true do |f| %>
    <%= f.error_messages %>

    <%= f.input :nombre, wrapper_html: { class: 'col-sm-8' }, label: 'Nombre', placeholder: 'Ej: 5% Efectivo mayor a $30.000' %>

    <%= f.input :medio_pago_tipo, collection: [['Todos (cualquier medio)', '']] + Pedidos::MedioPago::TIPOS.map { |k, v| [v, k] }, label: 'Medio de Pago', wrapper_html: { class: 'col-sm-4' }, include_blank: false %>

    <%= f.input :tipo_descuento, collection: [['Importe Fijo', 'importe'], ['Porcentaje con Límite', 'porcentaje']], label: 'Tipo de Descuento', wrapper_html: { class: 'col-sm-4' }, input_html: { id: 'descuento_vm_tipo_descuento' } %>
    <%= f.input :importe, wrapper_html: { class: 'col-sm-4', id: 'dvm_campo_importe' }, label: 'Importe ($)', input_html: { step: '0.01', min: 0 } %>
    <%= f.input :porcentaje, wrapper_html: { class: 'col-sm-4', id: 'dvm_campo_porcentaje', style: 'display:none' }, label: 'Porcentaje (%)', input_html: { step: '0.01', min: 0, max: 100 } %>
    <%= f.input :limite_bonificacion, wrapper_html: { class: 'col-sm-4', id: 'dvm_campo_limite', style: 'display:none' }, label: 'Límite Bonificación ($)', input_html: { step: '0.01', min: 0 } %>

    <div class="col-sm-12"><hr style="margin: 5px 0 15px;"></div>

    <%= f.input :importe_minimo, wrapper_html: { class: 'col-sm-4' }, label: 'Importe Mínimo ($)', input_html: { step: '0.01', min: 0 }, hint: 'Importe desde el cual aplica el descuento' %>

    <%= f.input :cliente_ids, collection: Clientes::Cliente.disponibles_en(current_user.tienda_activa).active.order(:nombre),
                label_method: :nombre, value_method: :id,
                label: 'Clientes (vacío = todos)',
                wrapper_html: { class: 'col-sm-8' },
                input_html: { multiple: true, class: 'select2', data: { placeholder: 'Todos los clientes' } },
                hint: 'Dejar vacío para aplicar a todos los clientes' %>

    <% unless @descuento.new_record? %>
      <%= f.input :activo, as: :boolean, wrapper_html: { class: 'col-sm-4' }, label: 'Activo' %>
    <% end %>

    <div class="col-md-12">
      <%= f.submit (@descuento.new_record? ? 'Crear' : 'Guardar'), class: "btn btn-success waves-effect waves-light m-r-10" %>
      <%= link_to('Eliminar', ventas_mostrador_descuento_path(@descuento), class: "btn btn-danger waves-effect waves-light m-r-10", method: :delete, remote: true, data: { confirm: "¿Está seguro que desea eliminar este descuento?" }) if !@descuento.new_record? && can?(:destroy, @descuento) %>
      <%= link_to('Cerrar', nil, class: "btn btn-default waves-effect waves-light m-r-10", data: { dismiss: 'modal' }) %>
    </div>
  <% end %>

  <script>
    $(function() {
      function toggleTipoDescuento() {
        var tipo = $('#descuento_vm_tipo_descuento').val();
        if (tipo === 'importe') {
          $('#dvm_campo_importe').show();
          $('#dvm_campo_porcentaje, #dvm_campo_limite').hide();
        } else {
          $('#dvm_campo_importe').hide();
          $('#dvm_campo_porcentaje, #dvm_campo_limite').show();
        }
      }
      toggleTipoDescuento();
      $('#descuento_vm_tipo_descuento').on('change', toggleTipoDescuento);
      $('.select2').select2({ width: '100%' });
    });
  </script>
<% end %>
