<%= modal 'form-modal', title: 'Eliminar Cupones' do %>
  <%= form_tag eliminar_masivo_cupones_path, method: :delete do %>
    <div class="row">
      <div class="col-sm-12">
        <h6 class="font-light" style="color: #888; margin-bottom: 10px;">
          Ingrese un código de cupón o un grupo para eliminar. Solo se eliminan cupones que no estén asociados a un pedido.
        </h6>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-6">
        <div class="form-group">
          <label>Código de cupón</label>
          <input type="text" name="codigo" class="form-control" placeholder="Ej: ABC12345" maxlength="20">
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group">
          <label>Grupo</label>
          <input type="text" name="grupo" class="form-control" placeholder="ID de grupo">
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-12">
        <p class="text-muted" style="font-size: 0.9em;">
          <i class="fa fa-info-circle"></i>
          Los cupones que ya fueron usados en un pedido no serán eliminados.
        </p>
      </div>
    </div>

    <div class="col-md-12">
      <%= submit_tag 'Eliminar', class: 'btn btn-danger waves-effect waves-light m-r-10', data: { confirm: '¿Está seguro? Esta acción no se puede deshacer.' } %>
      <%= link_to 'Cerrar', nil, class: 'btn btn-default waves-effect waves-light m-r-10', data: { dismiss: 'modal' } %>
    </div>
  <% end %>
<% end %>
