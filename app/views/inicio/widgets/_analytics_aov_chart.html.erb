<%# Monthly AOV (Pesos + USD dual axis line chart). %>
<% labels = @analytics[:chart_labels] %>
<% pesos = @analytics[:aov_values_pesos] %>
<% usd = @analytics[:aov_values_usd] %>
<div class="card">
  <div class="card-body">
    <h3 class="card-title">Ticket Promedio Mensual (AOV)</h3>
    <h6 class="card-subtitle">Pesos y dólares / pedidos por mes (últimos 12 meses)</h6>
    <% if labels.any? %>
      <%= content_tag :span, nil, id: 'inicio-analytics-aov', data: { labels: labels, pesos: pesos, usd: usd } %>
      <div style="position: relative; height: 250px;"><canvas id="inicio-analytics-aov-chart"></canvas></div>
      <script>
        (function() {
          var $el = $('#inicio-analytics-aov');
          if (!$el.data('labels')) return;
          function fmtArs(v) { var p = v.toString().split('.'); p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.'); return '$ ' + p.join(','); }
          function fmtUsd(v) { var p = v.toString().split('.'); p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.'); return 'US$ ' + p.join(','); }
          new Chart(document.getElementById('inicio-analytics-aov-chart').getContext('2d'), {
            type: 'line',
            data: {
              labels: $el.data('labels'),
              datasets: [
                { label: 'Pesos', data: $el.data('pesos'), borderColor: '#7460ee', backgroundColor: 'rgba(116, 96, 238, 0.05)', borderWidth: 2, fill: true,  yAxisID: 'y' },
                { label: 'Dólares', data: $el.data('usd'),   borderColor: '#02af1f', backgroundColor: 'rgba(2, 175, 31, 0.05)',   borderWidth: 2, fill: true,  yAxisID: 'y1' }
              ]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              scales: {
                y:  { type: 'linear', position: 'left',  beginAtZero: true, ticks: { callback: fmtArs, color: '#7460ee' }, grid: { color: '#eef0f2' }, title: { display: true, text: 'Pesos', color: '#7460ee' } },
                y1: { type: 'linear', position: 'right', beginAtZero: true, ticks: { callback: fmtUsd, color: '#02af1f' }, grid: { drawOnChartArea: false }, title: { display: true, text: 'Dólares', color: '#02af1f' } },
                x:  { grid: { color: '#eef0f2' } }
              },
              plugins: {
                legend: { display: true, position: 'top' },
                tooltip: {
                  mode: 'index', intersect: false,
                  callbacks: {
                    label: function(ctx) {
                      var v = ctx.parsed.y; var p = v.toFixed(0).toString().split('.'); p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                      return ctx.dataset.yAxisID === 'y1' ? 'Dólares: US$ ' + p.join(',') : 'Pesos: $ ' + p.join(',');
                    }
                  }
                }
              }
            }
          });
        })();
      </script>
    <% else %>
      <p class="text-muted text-center py-4">Sin datos en los últimos 12 meses.</p>
    <% end %>
  </div>
</div>
