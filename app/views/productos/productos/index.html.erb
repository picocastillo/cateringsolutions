<% page title: 'Ver Productos', raiz: 'Cocina', hojas: 'Ver Productos', acciones: [link_to('Nuevo', new_producto_path)].compact, id: 'index-productos' %>
  <div class="row">
    <div class="col-12">
      <div class="card filtros">
        <div class="bg-info" >
          <h4 class="text-white card-title">Filtros<div class="card-actions">
              <a class="" data-action="collapse"><i class="ti-plus"></i></a>
              <a class="btn-close" data-action="close"><i class="ti-close"></i></a>
          </div>
        </h4>
        </div>
        <div class="card-body collapse">
          <%= error_messages_for @query %>
          <%= query_form_for @query, remote: true do |f| %>
            <%= f.input :codigo, input_html: { autocomplete: 'off' } %>
            <%= f.input :categoria_ids, as: :select2_local, collection: Productos::Categoria.order(:codigo).where(tienda_id: tienda_activa).active, prompt: ' - Todas - ', label: 'Categorías', input_html: {multiple: true, autocomplete: 'off'} %>
            <%= f.input :clientes_ids, as: :select2_local, collection: Clientes::Cliente.active.order(:nombre).disponibles_en(tienda_activa), prompt: ' - Seleccione - ', label: 'Precios activos para', input_html: {multiple: false, autocomplete: 'off'} %>
            <%= f.input :activo_el, as: :string, required: false, input_html: { class: 'singledate', autocomplete: 'off' } %>
            <%= f.input :nombre, input_html: { autocomplete: 'off' } %>
            <%= f.input :codigo_externo, input_html: { autocomplete: 'off' } %>
            <%= f.input :descripcion, label: 'Descripción', input_html: { autocomplete: 'off' } %>
            <%= f.input :pesable, label: 'Pesable', as: :select, collection: [['Sí', 'true'], ['No', 'false']], include_blank: '- Todos -', input_html: { autocomplete: 'off' } %>
            <%= f.input :status, as: :status, input_html: { autocomplete: 'off' } %>
            <%= search_buttons f %>
          <% end %>
        </div>
      </div>
      <div class="card">
          <div class="card-header">
              <div class="card-actions">

                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
        <span id=productos-container> <%= render 'resultados' %></span>
      </div>
  </div>
</div>
