<% content_for :styles do %>
  @page {
    size: 80mm auto;
    margin: 2mm;
  }
  body {
    font-family: Calibri;
    text-align: center;
    font-size: 12px;
  }
  .titulo {
    font-size: 18px;
    font-weight: bold;
    margin: 10px 0;
  }
  .success {
    font-size: 14px;
    color: #28a745;
    margin: 10px 0;
  }
  .linea {
    border-top: 1px dashed #000;
    margin: 8px 0;
  }
  .info {
    font-size: 10px;
    color: #666;
  }
<% end %>

<div class="titulo">PRUEBA DE IMPRESIÓN</div>
<div class="linea"></div>
<div class="success">✓ ¡Impresora configurada correctamente!</div>
<div class="linea"></div>
<p><%= tienda_activa&.nombre %></p>
<p class="info"><%= Time.current.strftime('%d/%m/%Y %H:%M') %></p>
<p class="info">QZ Tray - Impresión Automática</p>
<div class="linea"></div>
<p class="info">Si puede leer esto, la impresora funciona bien.</p>
