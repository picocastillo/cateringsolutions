<% header_id = local_assigns.fetch(:header_id, 'pedido-title') %>
<style>
  #<%= header_id %>, #<%= header_id %> *, #<%= header_id %> a { color: #fff !important; }
  #<%= header_id %> .muted, #<%= header_id %> a .muted, #<%= header_id %> div.muted, #<%= header_id %> span.muted {
    color: #fff !important; opacity: 0.9 !important; font-size: 0.85rem !important;
    font-weight: 300 !important; margin-left: 0 !important; margin-top: 2px !important;
  }
  #<%= header_id %> .nowrap { margin-top: 2px !important; line-height: 1.2; }
</style>
<div id="<%= header_id %>" class="text-white py-2 px-3 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; border-radius: 12px 12px 0 0; margin-bottom: 0;">
  <i class="mdi mdi-receipt mr-3" style="font-size: 2.2rem; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.3);"></i>
  <div style="line-height: 1.3;">
    <h5 class="mb-0 font-weight-bold text-white" style="font-size: 1.4rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
      <%= current_user.cliente? ? @pedido.para_to_s_vertical : (@pedido.usuario ? link_to(discontinuado(@pedido.usuario, @pedido.to_s_vertical), usuario_path(@pedido.usuario), class: 'text-white') : link_to(discontinuado(@pedido.cuenta, @pedido.para_to_s_vertical), cliente_path(@pedido.cuenta.cliente), class: 'text-white')) %>
    </h5>
  </div>
</div>
