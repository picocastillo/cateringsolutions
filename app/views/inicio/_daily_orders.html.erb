<% if current_user.admin? && tienda_activa && tienda_activa.carrito_de_compras %>
  <!-- Enhanced Daily Orders Section -->
  <div class="mb-4" id="daily-orders-container">
    <div class="shadow-lg border-0 overflow-hidden mx-auto" style="max-width: 100%;">
      <!-- Compact Header with Gradient -->
      <div class="card-header border-0 p-0">
        <div class="text-white py-2 px-3 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
          <i class="mdi mdi-chef-hat mr-3" style="font-size: 2.2rem; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.3);"></i>
          <div>
            <h1 class="mb-0 font-weight-bold text-white" style="font-size: 1.6rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
              Panel de Cocina
            </h1>
            <p class="mb-0 font-weight-light text-white" style="font-size: 0.95rem; opacity: 0.9;">
              Gestión de pedidos en tiempo real
            </p>
          </div>
        </div>
      </div>
      
      <!-- Enhanced Stats Cards -->
      <div class="card-body p-0">
        <div class="d-flex flex-wrap">
          <!-- Total Card -->
          <div class="flex-fill text-center py-4 px-3 border-right border-bottom" style="min-width: 200px;">
            <div class="mb-2">
              <i class="mdi mdi-calendar-today text-primary" style="font-size: 2rem; opacity: 0.7;"></i>
            </div>
            <h2 class="text-primary font-weight-bold mb-2" data-counter="total_pedidos_hoy" style="font-size: 2.5rem;">
              <% pedidos_hoy = @total_pedidos_hoy || local_assigns[:total_pedidos_hoy] %>
              <%= pedidos_hoy %>
            </h2>
            <h5 class="text-dark mb-1 font-weight-semibold">Total</h5>
            <small class="text-muted">para hoy</small>
          </div>
          
          <!-- Pendientes Card -->
          <div class="flex-fill text-center py-4 px-3 border-right border-bottom" style="min-width: 200px;">
            <div class="mb-2">
              <i class="mdi mdi-clock-outline text-warning" style="font-size: 2rem; opacity: 0.7;"></i>
            </div>
            <h2 class="text-warning font-weight-bold mb-2" data-counter="pedidos_pendientes" style="font-size: 2.5rem;">
              <%= @pedidos_pendientes || local_assigns[:pedidos_pendientes] %>
            </h2>
            <h5 class="text-dark mb-1 font-weight-semibold">Pendientes</h5>
            <% if @pedidos_pendientes_cortes.present? %>
              <small class="text-muted text-center" data-cortes style="line-height: 1.3;">
                Próximos cortes:<br>
                <% now_time = Time.current.strftime('%H:%M') %>
                <% next_corte = @pedidos_pendientes_cortes.detect { |c| c > now_time } %>
                <strong><%= @pedidos_pendientes_cortes.map { |x|
                  if x == next_corte
                    "<span class='badge badge-warning'>#{x}hs</span>"
                  else
                    "#{x}hs"
                  end
                }.join(' ').html_safe %></strong>
              </small>
            <% else %>
              <small class="text-muted" data-cortes>en espera</small>
            <% end %>
          </div>
          
          <!-- Listos Card -->
          <div class="flex-fill text-center py-4 px-3 border-right border-bottom" style="min-width: 200px;">
            <div class="mb-2">
              <% a_cocinar = @pedidos_listos_cocinar || local_assigns[:pedidos_listos_cocinar] %>
              <i class="mdi mdi-fire <%= a_cocinar > 0 ? 'text-danger' : 'text-success' %>" style="font-size: 2rem; opacity: 0.7;"></i>
            </div>
            <h2 class="font-weight-bold mb-2 <%= (pedidos_hoy == 0 || a_cocinar == 0) ? 'text-success' : 'text-danger' %>" data-counter="pedidos_listos_cocinar" style="font-size: 2.5rem;">
              <%= a_cocinar %>
            </h2>
            <h5 class="text-dark mb-1 font-weight-semibold">Esperando</h5>
            <small class="text-muted">preparación</small>
          </div>
          
          <!-- En Cocina Card -->
          <div class="flex-fill text-center py-4 px-3 border-bottom" style="min-width: 200px;">
            <div class="mb-2">
              <% pedidos_cocinados = @pedidos_cocinados || local_assigns[:pedidos_cocinados] %>
              <i class="mdi mdi-chef-hat text-info" style="font-size: 2rem; opacity: 0.7;"></i>
            </div>
            <h2 class="font-weight-bold mb-2 <%= (pedidos_hoy == 0 || a_cocinar == 0 || pedidos_cocinados == pedidos_hoy) ? 'text-success' : 'text-info' %>" data-counter="pedidos_cocinados" style="font-size: 2.5rem;">
              <%= pedidos_cocinados %>
            </h2>
            <h5 class="text-dark mb-1 font-weight-semibold">Cocinando</h5>
            <small class="text-muted">o finalizados</small>
          </div>
        </div>
      </div>
      
      <!-- Action Button -->
      <% if @link_cocina %>
        <div class="card-footer bg-light border-0 text-center py-3">
          <%= link_to '/pedidos_cocina', class: 'btn btn-primary btn-lg px-5 rounded-pill shadow-sm' do %>
            <i class="mdi mdi-chef-hat mr-2"></i>
            Ir a Pedidos de Cocina
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <style>
    #daily-orders-container .card {
      transition: all 0.3s ease;
    }
    
    #daily-orders-container .card:hover {
      transform: translateY(-2px);
    }
    
    #daily-orders-container [data-counter] {
      transition: all 0.3s ease;
      position: relative;
    }
    
    #daily-orders-container [data-counter]:after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: currentColor;
      transition: width 0.3s ease;
    }
    
    #daily-orders-container .flex-fill:hover [data-counter]:after {
      width: 60%;
    }
    
    @media (max-width: 767px) {
      #daily-orders-container h2 {
        font-size: 2rem !important;
      }
      
      #daily-orders-container h1 {
        font-size: 1.3rem !important;
      }
      
      #daily-orders-container .d-flex.flex-wrap {
        flex-direction: column !important;
      }
      
      #daily-orders-container .flex-fill {
        border-right: none !important;
        min-width: auto !important;
      }
    }
  </style>
<% end %>