<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }
    h1 { color: #c0392b; border-bottom: 3px solid #c0392b; padding-bottom: 10px; }
    h2 { color: #555; margin-top: 30px; }
    .summary { background: #f8f9fa; padding: 15px; border-left: 4px solid #3498db; margin: 20px 0; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    th { background: #34495e; color: white; padding: 12px; text-align: left; }
    td { padding: 10px; border-bottom: 1px solid #ddd; }
    tr:hover { background: #f5f5f5; }
    .critico { color: #c0392b; font-weight: bold; }
    .bajo { color: #e67e22; font-weight: bold; }
    .sin-stock { color: #95a5a6; font-weight: bold; }
    .local { font-size: 0.9em; color: #7f8c8d; }
  </style>
</head>
<body>
  <div class="container">
    <h1>⚠️ Alerta de Stock - <%= @tienda.nombre %></h1>
    
    <div class="summary">
      <p><strong>Resumen del día:</strong> <%= Date.current.strftime('%d/%m/%Y') %></p>
      <p>
        <strong>Total de alertas:</strong> <%= @total_alerts %><br>
        <span class="critico">Críticos:</span> <%= @stocks_criticos.count %> |
        <span class="bajo">Bajos:</span> <%= @stocks_bajos.count %> |
        <span class="sin-stock">Sin Stock:</span> <%= @stocks_sin_stock.count %>
      </p>
    </div>

    <% if @stocks_criticos.any? %>
      <h2 class="critico">🔴 Stock Crítico (<%= @stocks_criticos.count %>)</h2>
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Local</th>
            <th>Cantidad Actual</th>
            <th>Mínimo</th>
          </tr>
        </thead>
        <tbody>
          <% @stocks_criticos.each do |stock| %>
            <tr>
              <td><strong><%= stock.producto.nombre %></strong></td>
              <td><%= stock.producto.categoria.nombre %></td>
              <td class="local"><%= stock.local&.nombre || 'Principal' %></td>
              <td class="critico"><%= stock.cantidad_actual.to_i %></td>
              <td><%= stock.cantidad_minima.to_i %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if @stocks_bajos.any? %>
      <h2 class="bajo">🟡 Stock Bajo (<%= @stocks_bajos.count %>)</h2>
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Local</th>
            <th>Cantidad Actual</th>
            <th>Mínimo</th>
          </tr>
        </thead>
        <tbody>
          <% @stocks_bajos.each do |stock| %>
            <tr>
              <td><strong><%= stock.producto.nombre %></strong></td>
              <td><%= stock.producto.categoria.nombre %></td>
              <td class="local"><%= stock.local&.nombre || 'Principal' %></td>
              <td class="bajo"><%= stock.cantidad_actual.to_i %></td>
              <td><%= stock.cantidad_minima.to_i %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if @stocks_sin_stock.any? %>
      <h2 class="sin-stock">⚪ Sin Stock (<%= @stocks_sin_stock.count %>)</h2>
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Local</th>
            <th>Mínimo</th>
          </tr>
        </thead>
        <tbody>
          <% @stocks_sin_stock.each do |stock| %>
            <tr>
              <td><strong><%= stock.producto.nombre %></strong></td>
              <td><%= stock.producto.categoria.nombre %></td>
              <td class="local"><%= stock.local&.nombre || 'Principal' %></td>
              <td><%= stock.cantidad_minima.to_i %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <hr style="margin: 30px 0; border: none; border-top: 1px solid #ddd;">
    <p style="font-size: 0.9em; color: #7f8c8d;">
      Este es un reporte automático generado por el sistema de gestión de stock.<br>
      Para más detalles, acceda al sistema de gestión.
    </p>
  </div>
</body>
</html>
