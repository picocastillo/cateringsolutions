<% page title: @producto.to_s, raiz: 'Productos', hojas: 'Detalles', id: 'show-producto', acciones: [link_to('Editar', edit_producto_path(@producto)), link_to('Lista', productos_path)] %>

<div class="row">
                    <!-- Column -->
                    <div class="col-lg-4 col-xlg-3 col-md-5">
                        <div class="card">
                            <div class="card-body">
                                <center class="m-t-30"> <img src="<%= @producto.imagen_principal %>" width="150" style="background: <%= @producto.color_safe %>">
                                    <h2 class="card-title m-t-10 m-b-5"><%= @producto.nombre %></h2>
                                    <h4 class="card-subtitle m-b-5"><%= @producto.categoria %></h4>
                                    <div class="m-b-20"><%= active_label @producto %></div>
                                    <div class="row text-center justify-content-md-center">
                                        <div class="col-4"><a href="javascript:void(0)" class="link" data-toggle="tooltip" data-original-title="Consumido por <%= @total_usuarios_distintos %> personas"><i class="icon-people"></i> <font class="font-medium"><%= @total_usuarios_distintos %></font></a></div>
                                        <div class="col-4"><a href="javascript:void(0)" class="link" data-toggle="tooltip" data-original-title="Pedido <%= @total_cantidad_pedida %> veces"><i class="icon-notebook"></i> <font class="font-medium"><%= @total_cantidad_pedida %></font></a></div>
                                    </div>
                                </center>
                            </div>
                            <div>
                                <hr> </div>
                            <div class="card-body  p-b-30">
                                <% if @producto.codigo.present? %>
                                  <small class="text-muted">Código </small>
                                  <h6><%= @producto.codigo %></h6>
                                <% end %>
                                <% if @producto.codigos_externos.present? %>
                                  <small class="text-muted">Códigos Externos </small>
                                  <h6><%= @producto.codigos_externos %></h6>
                                <% end %>
                                <% if @producto.descripcion.present? %>
                                  <small class="text-muted">Descripción </small>
                                  <h6><%= @producto.descripcion %></h6>
                                <% end %>
                            </div>
                        </div>
                    </div>
                    <!-- Column -->
                    <!-- Column -->
                    <div class="col-lg-8 col-xlg-9 col-md-7">
                        <div class="card">
                            <div class="card-body">
                                        <% precios_vigentes = @producto.precios.select(&:vigente?).sort_by { |x| x.clientes.present? ? x.clientes.map(&:to_s).join(', ') : '' } %>
                                        <% precios_viejos = @producto.precios.reject(&:vigente?).sort_by { |x| -1 * x.fecha_desde.to_datetime.to_i } %>

                                        <% if precios_vigentes.any? %>
                                          <div class="card mb-4" style="border: none;">
                                            <div class="card-body bg-success row" style="margin: 0; padding: 1rem 1.25rem; border-radius: 4px 4px 0 0;">
                                              <div class="col-12">
                                                <h5 class="text-white card-title mb-0">
                                                  <i class="ti-check"></i> Precios Vigentes
                                                </h5>
                                              </div>
                                            </div>
                                            <div class="table-responsive" style="border: 1px solid #e9ecef; border-top: none; border-radius: 0 0 4px 4px;">
                                              <table class="table mb-0">
                                                <thead>
                                                  <tr>
                                                    <th>Clientes</th>
                                                    <th class="text-right">Fecha Desde</th>
                                                    <th class="text-right">Fecha Hasta</th>
                                                    <th class="text-right">Importe</th>
                                                  </tr>
                                                </thead>
                                                <tbody>
                                                  <% precios_vigentes.each do |pr| %>
                                                    <tr>
                                                      <td><h6 class="mb-0"><%= pr.clientes.present? ? pr.clientes.map { |c| c.to_s.downcase.titleize }.to_sentence : 'Todos' %></h6></td>
                                                      <td class="text-right"><%= pr.fecha_desde %></td>
                                                      <td class="text-right"><%= pr.fecha_hasta %></td>
                                                      <td class="text-right"><strong><%= Danconia::Money.new(pr.importe) %></strong></td>
                                                    </tr>
                                                  <% end %>
                                                </tbody>
                                              </table>
                                            </div>
                                          </div>
                                        <% else %>
                                          <div class="alert alert-warning mb-4">
                                            <i class="ti-alert"></i> No hay precios vigentes para este producto.
                                          </div>
                                        <% end %>

                                        <% if precios_viejos.any? %>
                                          <div class="card" style="border: none;">
                                            <div class="card-body row" style="margin: 0; padding: 0.75rem 1.25rem; background: #f8f9fa; border-radius: 4px 4px 0 0; border: 1px solid #e9ecef; border-bottom: none; cursor: pointer;" data-toggle="collapse" data-target="#precios-historicos">
                                              <div class="col-12 d-flex align-items-center justify-content-between">
                                                <h6 class="text-muted mb-0">
                                                  <i class="ti-time"></i> Precios Anteriores (<%= precios_viejos.count %>)
                                                </h6>
                                                <i class="ti-angle-down text-muted"></i>
                                              </div>
                                            </div>
                                            <div class="collapse" id="precios-historicos">
                                              <div class="table-responsive" style="max-height: 300px; overflow-y: auto; border: 1px solid #e9ecef; border-radius: 0 0 4px 4px;">
                                                <table class="table table-sm mb-0">
                                                  <thead>
                                                    <tr>
                                                      <th>Clientes</th>
                                                      <th class="text-right">Fecha Desde</th>
                                                      <th class="text-right">Fecha Hasta</th>
                                                      <th class="text-right">Importe</th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    <% precios_viejos.each do |pr| %>
                                                      <tr>
                                                        <td class="text-muted"><%= pr.clientes.present? ? pr.clientes.map { |c| c.to_s.downcase.titleize }.to_sentence : 'Todos' %></td>
                                                        <td class="text-right text-muted"><%= pr.fecha_desde %></td>
                                                        <td class="text-right text-muted"><%= pr.fecha_hasta %></td>
                                                        <td class="text-right text-muted"><%= Danconia::Money.new(pr.importe) %></td>
                                                      </tr>
                                                    <% end %>
                                                  </tbody>
                                                </table>
                                              </div>
                                            </div>
                                          </div>
                                        <% end %>
                            </div>
                        </div>
                    </div>
                    <!-- Column -->
                </div>
