  <% if @pedido.cargando_inicial? || @pedido.valid? %>
    $("#input-para").html("<%= j render 'input_para' %>");
  <% else %>
    toast.error({ html: '<%= "#{@pedido.to_s}: #{@pedido.errors.full_messages.to_sentence}" %>', duration: 7000 });
  <% end %>
  $.each($('.productos_solicitados .select2-remote:not(.selectado)'), function() {
    $(this).addClass('selectado');
    $(this).remoteSelect2($(this).data());
  });
  $('#pedido_para_id').select2($('#pedido_para_id').data());
