<% page title: current_user.cliente? ? 'Descargas' : 'Procesos', raiz: current_user.cliente? ? 'Descargas' : 'Procesos', hojas: 'Lista', id: 'index-procesos' %>
<% refresh 60.seconds, update: '#resultados-procesos' %>
<div class="card">
    <div class="card-header">
        <div class="card-actions">
          <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
        </div>
    </div>
    <span id="resultados-procesos"> <%= render 'resultados' %></span>
</div>
