<% page title: 'Grupos', raiz: 'Cocina', hojas: 'Grupos', acciones: [link_to('Nuevo', new_grupo_cocina_path, remote: true)], id: 'index-grupos_cocinas' %>

  <div class="row">
    <div class="col-md-12">
      <div class="card" id="listado-grupos_cocinas">
          <div class="card-header">
              <div class="card-actions">

                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
          <div class="card-body collapse show">
            <div class="table-responsive">
              <%= table_for @grupos_cocinas, id: 'grupos_cocinas' do |t| %>
                <% t.column(:codigo) %>
                <% t.column(:nombre) %>
                <% t.column(:categorias)  { |t| t.categorias.join(', ')}  %>
                <% t.column(:descripcion, header: 'Descripción') %>
                <% t.actions { |t| [link_to(content_tag(:i, nil, class: 'ti-marker-alt').html_safe, edit_grupo_cocina_path(t, {de_lista: true}), remote: true, data: {toggle: 'tooltip', "original-title" => 'Editar' }), (link_to(content_tag(:i, nil, class: 'ti-trash').html_safe, grupo_cocina_path(t, {de_lista: 'true'}), method: :delete, remote: true, data: {confirm: "Está seguro que desea eliminar el grupo '#{t}'?", toggle: 'tooltip', "original-title" => 'Eliminar' }) if can?(:destroy, t))]} %>
              <% end %>
            </div>
          </div>
          <%= paginador @grupos_cocinas %>
      </div>
  </div>
</div>
