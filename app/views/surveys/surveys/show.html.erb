<% content_for :page_id, 'surveys-show' %>

<div class="container-fluid pt-4" style="margin-top: 80px">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="col-12 bg-white border-bottom" style="padding: 0.75rem 1.25rem !important;">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">
              <i class="fa fa-list-alt text-primary"></i>
              <%= @survey.title %>
            </h4>
            <div class="btn-group">
              <% if can? :update, @survey %>
                <%= link_to edit_survey_path(@survey), class: 'btn btn-warning btn-sm' do %>
                  <i class="fa fa-edit"></i>
                  Editar
                <% end %>
              <% end %>
              <%= link_to surveys_path, class: 'btn btn-secondary btn-sm ml-2' do %>
                <i class="fa fa-arrow-left"></i>
                Volver
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="card-body">
          <div class="row">
            <div class="col-md-8">
              <% if @survey.description.present? %>
                <div class="mb-4">
                  <h6 class="text-muted mb-2">Descripción</h6>
                  <div class="text-dark"><%= simple_format(@survey.description) %></div>
                </div>
              <% end %>
              
              <!-- Statistics Cards -->
              <div class="row mb-4">
                <div class="col-md-4 mb-3">
                  <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center py-4">
                      <i class="fa fa-calendar fa-2x text-primary mb-3"></i>
                      <h6 class="card-title mb-2">Periodo</h6>
                      <p class="card-text text-muted mb-0"><%= @survey.date_range_text %></p>
                    </div>
                  </div>
                </div>
                
                <div class="col-md-4 mb-3">
                  <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center py-4">
                      <i class="fa fa-question-circle fa-2x text-info mb-3"></i>
                      <h6 class="card-title mb-2">Preguntas</h6>
                      <p class="card-text text-muted mb-0"><%= @survey.questions.count %></p>
                    </div>
                  </div>
                </div>
                
                <div class="col-md-4 mb-3">
                  <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center py-4">
                      <i class="fa fa-users fa-2x text-success mb-3"></i>
                      <h6 class="card-title mb-2">Respuestas</h6>
                      <p class="card-text text-muted mb-0"><%= @total_responses %></p>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Questions Section -->
              <% if @survey.questions.any? %>
                <div class="mb-4">
                  <h5 class="mb-3 d-flex align-items-center">
                    <i class="fa fa-question-circle text-info mr-2"></i>
                    Preguntas de la Encuesta
                  </h5>
                  
                  <% @survey.questions.each_with_index do |question, index| %>
                    <div class="card mb-3 border-left border-primary">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                          <div class="flex-grow-1">
                            <h6 class="card-title text-dark mb-2">
                              <span class="badge badge-light mr-2"><%= index + 1 %></span>
                              <%= question.text %>
                              <% if question.required? %>
                                <span class="badge badge-warning ml-2">
                                  <i class="fa fa-asterisk"></i> Obligatoria
                                </span>
                              <% end %>
                            </h6>
                            <div class="text-muted">
                              <small>
                                <i class="fa fa-tag mr-1"></i>
                                Tipo: 
                                <% case question.question_type %>
                                <% when 'text' %>
                                  <span class="badge badge-info">Texto libre</span>
                                <% when 'multiple_choice' %>
                                  <span class="badge badge-primary">Opción múltiple</span>
                                <% when 'scale' %>
                                  <span class="badge badge-success">Escala (1-5)</span>
                                <% end %>
                              </small>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <i class="fa fa-question-circle fa-4x text-muted mb-3"></i>
                  <h5 class="text-muted mb-2">Sin preguntas configuradas</h5>
                  <p class="text-muted mb-3">Esta encuesta no tiene preguntas. Agregue al menos una pregunta para que los usuarios puedan completarla.</p>
                  <% if can? :update, @survey %>
                    <%= link_to edit_survey_path(@survey), class: 'btn btn-primary' do %>
                      <i class="fa fa-plus mr-1"></i>
                      Agregar Preguntas
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <!-- Status Sidebar -->
            <div class="col-md-4">
              <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-0">
                  <h6 class="card-title mb-0 float-left">
                    <i class="fa fa-info-circle text-info mr-2"></i>
                    Estado de la Encuesta
                  </h6>
                </div>
                <div class="card-body">
                  <div class="mb-3 p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                      <strong class="text-dark">Estado:</strong>
                      <% if @survey.active? %>
                        <span class="badge badge-success px-3 py-2">
                          <i class="fa fa-check-circle mr-1"></i>
                          Activa
                        </span>
                      <% else %>
                        <span class="badge badge-secondary px-3 py-2">
                          <i class="fa fa-pause mr-1"></i>
                          Inactiva
                        </span>
                      <% end %>
                    </div>
                  </div>
                  
                  <div class="mb-3 p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                      <strong class="text-dark">Periodo activo:</strong>
                      <% if @survey.active_period? %>
                        <span class="badge badge-success px-3 py-2">
                          <i class="fa fa-check mr-1"></i>
                          Vigente
                        </span>
                      <% else %>
                        <span class="badge badge-warning px-3 py-2">
                          <i class="fa fa-exclamation-triangle mr-1"></i>
                          Fuera de periodo
                        </span>
                      <% end %>
                    </div>
                  </div>
                  
                  <div class="mb-4 p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                      <strong class="text-dark">Disponible:</strong>
                      <% if @survey.active? && @survey.active_period? %>
                        <span class="badge badge-success px-3 py-2">
                          <i class="fa fa-eye mr-1"></i>
                          Visible
                        </span>
                      <% else %>
                        <span class="badge badge-danger px-3 py-2">
                          <i class="fa fa-eye-slash mr-1"></i>
                          Oculta
                        </span>
                      <% end %>
                    </div>
                  </div>
                  
                  <!-- Action Buttons -->
                  <div class="border-top pt-3">
                    <% if @survey.active? && @survey.active_period? && @survey.questions.any? %>
                      <% if @user_response.present? %>
                        <div class="alert alert-info mb-3">
                          <i class="fa fa-check-circle mr-2"></i>
                          Ya has respondido esta encuesta
                        </div>
                        <%= link_to survey_survey_response_path(@survey, @user_response), class: 'btn btn-outline-primary btn-block mb-2' do %>
                          <i class="fa fa-eye mr-2"></i>
                          Ver mi respuesta
                        <% end %>
                      <% else %>
                        <%= link_to new_survey_survey_response_path(@survey), class: 'btn btn-success btn-block mb-2' do %>
                          <i class="fa fa-play mr-2"></i>
                          Responder Encuesta
                        <% end %>
                      <% end %>
                    <% end %>
                    
                    <% if @total_responses > 0 %>
                      <%= link_to survey_survey_responses_path(@survey), class: 'btn btn-info btn-block' do %>
                        <i class="fa fa-bar-chart mr-2"></i>
                        Ver Respuestas (<%= @total_responses %>)
                      <% end %>
                    <% end %>
                    
                    <% unless @survey.active? && @survey.active_period? && @survey.questions.any? %>
                      <div class="alert alert-warning mb-0" role="alert">
                        <small>
                          <i class="fa fa-exclamation-triangle mr-1"></i>
                          <strong>No disponible:</strong><br>
                          <% unless @survey.active? %>
                            • La encuesta está inactiva<br>
                          <% end %>
                          <% unless @survey.active_period? %>
                            • Fuera del periodo activo<br>
                          <% end %>
                          <% unless @survey.questions.any? %>
                            • Sin preguntas configuradas
                          <% end %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
