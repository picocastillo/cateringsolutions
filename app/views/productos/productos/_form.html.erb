  <div>
    <%= simple_nested_form_for @producto do |f| %>
    <%= f.error_messages %>
    <div class="col-md-12">
      <div class="card">
        <div class="card-body">
          <ul class="nav nav-tabs profile-tab" role="tablist">
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#general" role="tab">General</a> </li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#listaprecios" role="tab">Precios</a> </li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active form-material" id="general" role="tabpanel">
                <div class="card-body">
                  <%= f.hidden_field :tienda_id %>
                  <% unless @producto.new_record? %>
                    <% if tienda_activa.venta_mostrador? %>
                      <%= f.input :codigo, required: false, input_html: { readonly: true }, hint: 'El código se asigna automáticamente', wrapper_html: { class: 'col-sm-4' } %>
                    <% else %>
                      <%= f.input :codigo, required: false, wrapper_html: { class: 'col-sm-4' } %>
                    <% end %>
                  <% end %>
                  <%= f.input :codigos_externos, required: false, wrapper_html: { class: 'col-sm-4' } %>
                  <%= f.input :color, as: :color, wrapper_html: { class: 'col-sm-4' } %>
                  <%= f.input :nombre, required: true, wrapper_html: { class: 'col-sm-12' } %>
                  <%= f.input :categoria_id, collection: Productos::Categoria.where(tienda_id: tienda_activa.id).all, wrapper_html: { class: 'col-sm-6' }, required: true %>
                  <%= f.input :descripcion, wrapper_html: { class: 'col-sm-6' } %>
                  <% if tienda_activa.productos_pesables? %>
                    <% if @producto.pesable_bloqueado? %>
                      <%= f.input :pesable, as: :boolean, label: 'Pesable (venta por Kg)', input_html: { disabled: true }, hint: 'No se puede modificar porque el producto tiene stock o pedidos asociados', wrapper_html: { class: 'col-sm-4' } %>
                    <% else %>
                      <%= f.input :pesable, as: :boolean, label: 'Pesable (venta por Kg)', wrapper_html: { class: 'col-sm-4' } %>
                    <% end %>
                  <% end %>
                  <%= f.input :mostrar_como_nuevo_hasta, as: :string, label: 'Mostrar como nuevo hasta', input_html: { class: 'singledate' }, wrapper_html: { class: 'col-sm-4' } %>
                  <%= f.input :documentos, wrapper_html: { class: 'col-sm-12' } do %>
                    <%= render '/infraestructura/documentos/drag_and_drop_section', f: f, solo_imagenes: true, max_size: 10 %>
                  <% end %>
              </div>
            </div>
            <div class="tab-pane form-material" id="listaprecios" role="tabpanel">
              <div class="card-body">
                <div class="ayuda">
                  <h6 style="font-weight: 600">Ayuda: recuerde que para facturar se utilizará un precio con fecha vigente en el que este incluido el Cliente. Si no existe dicho precio intentara buscar un precio que no tenga clientes asignados, es decir que aplique a todos. Por último si no encuentra precio dicho producto no estará disponible para ese Cliente.</h6>
                </div>
                <%= render 'fields_precios', f: f %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-12">
    <%= f.default_button %>
    </div>
  <% end %>
  </div>
