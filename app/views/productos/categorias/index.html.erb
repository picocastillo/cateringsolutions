<% page title: 'Categorías', raiz: 'Cocina', hojas: 'Categorías', acciones: [link_to('Nuevo', new_categoria_path, remote: true), link_to('Exportar', '#')], id: 'index-categorias' %>

  <div class="row">
    <div class="col-md-12">
      <div class="card" id="listado-categorias">
          <div class="card-header">
              <div class="card-actions">

                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
          <div class="card-body collapse show">
            <div class="table-responsive">
              <%= table_for @categorias, id: 'categorias' do |t| %>
                <% t.column(:codigo) %>
                <% t.column(:nombre) %>
                <% t.column(:menu_diario) if tienda_activa.carrito_de_compras? %>
                <% t.column(:descripcion, header: 'Descripción') %>
                <% t.column(:stock_activo, header: 'Stock Activo', class: 'center') { |t| content_tag(:span, t.stock_activo ? 'Sí' : 'No', class: t.stock_activo ? 'label label-success' : 'label label-default') } %>
                <% t.column(:active, header: 'Activo', class: 'center hidden-md-down')  { |t| etiqueta_activo t }%>
                <% t.actions { |t| [link_to(content_tag(:i, nil, class: 'ti-marker-alt').html_safe, edit_categoria_path(t, {de_lista: true}), remote: true, data: {toggle: 'tooltip', "original-title" => 'Editar' }), link_to_activate(t), (link_to(content_tag(:i, nil, class: 'ti-trash').html_safe, categoria_path(t, {de_lista: 'true'}), method: :delete, remote: true, data: {confirm: "Está seguro que desea eliminar el categoria '#{t}'?", toggle: 'tooltip', "original-title" => 'Eliminar' }) if can?(:destroy, t))]} %>
              <% end %>
            </div>
          </div>
          <%= paginador @categorias %>
      </div>
  </div>
</div>
