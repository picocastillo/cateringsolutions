<% titr = @pedido.codigo.blank? ? "Nuevo Pedido" : "Editando #{@pedido.codigo_s}"   %>

<% page title: "Venta Mostrador", raiz: 'Pedidos', hojas: 'Venta Mostrador', id: 'index-venta-mostrador' %>
  <div class="row">
    <div class="col-md-12">
      <h4 class="mb-2 "><%= titr %></h4>
      <div class="card" id="listado-pedidos">
        <%= render 'form_completo' %>
      </div>
      <hr style="margin-top: -10px">
      <h4 class="mb-0">Pedidos</h4>
      <p class="text-muted mt-0 font-12">Listado de los últimos pedidos</p>
      <div class="card filtros">
        <div class="bg-info" >
          <h4 class="text-white card-title">Filtros<div class="card-actions">
              <a class="" data-action="collapse"><i class="<%= @filtro_abierto ? 'ti-minus' : 'ti-plus' %>"></i></a>
              <a class="btn-close" data-action="close"><i class="ti-close"></i></a>
          </div>
        </h4>
        </div>
        <div class="card-body collapse<%= ' show' if @filtro_abierto %>">
          <%= error_messages_for @query %>
          <%= query_form_for @query, url: ventas_mostrador_pedidos_path, remote: true do |f| %>
            <%= f.input :codigo, input_html: { autocomplete: 'off' } %>
            <%= f.input :fecha_desde, as: :string, required: false, input_html: { class: 'singledate', autocomplete: 'off' } %>
            <%= f.input :fecha_hasta, as: :string, required: false, input_html: { class: 'singledate', autocomplete: 'off' } %>
            <%= f.input :cliente_ids, label: 'Clientes', as: :select2, input_html: {data: {multiple: true, url: clientes_path(format: :json), pre: @query.cliente_ids.presence && Clientes::Cliente.where(id: @query.cliente_ids)}, autocomplete: 'off'}  unless current_user.cliente? %>
            <%= f.input :cuentas_ids, label: 'Cuentas', as: :select2, input_html: {data: {multiple: true, minimum_input_length: 1, label: 'cliente_y_nombre', selection: 'cliente_y_nombre', url: cuentas_path(format: :json), pre: @query.cuentas_ids.presence && Clientes::Cuenta.where(id: @query.cuentas_ids)}, autocomplete: 'off'} %>
            <%= f.input :estado_id, label: 'Estado', as: :select, collection: [Pedidos::Estado[:aceptado], Pedidos::Estado[:confirmado], Pedidos::Estado[:cancelado]] , label_method: :desc, include_blank: true, input_html: { autocomplete: 'off' } %>
            <%= f.input :descuento_venta_mostrador_id, label: 'Descuento', as: :select, collection: [['Con descuento', 'any']] + VentasMostrador::DescuentoVentaMostrador.where(tienda: tienda_activa, activo: true).order(:nombre).map { |d| [d.nombre, d.id] }, include_blank: true, input_html: { autocomplete: 'off' } %>
            <%= f.input :producto_ids, label: 'Productos', as: :select2, input_html: {data: {multiple: true, placeholder: 'Ingrese código o nombre', selection: 'codigo_y_nombre', label: 'codigo_y_nombre', url: productos_path(format: :json), pre: @query.productos.map{|p| { id: p.id, codigo_y_nombre: p.codigo_y_nombre }}}, class: 'seleccion-usuario', autocomplete: 'off'} if !current_user.cliente? %>
            <%= search_buttons f %>
          <% end %>
        </div>
      </div>

      <div class="card" id="listado-pedidos">
          <div class="card-header">
              <div class="card-actions">
                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
          <span id="pedidos-container">
            <%= render 'resultados' %>
          </span>
      </div>
  </div>
</div>
