<% content_for :title, @survey.title %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= @survey.title %></h3>
        </div>
        <div class="card-body">
          <% if @survey.description.present? %>
            <div class="alert alert-info">
              <%= simple_format(@survey.description) %>
            </div>
          <% end %>

          <%= simple_form_for [@survey, @survey_response], url: survey_survey_responses_path(@survey), method: :post, html: { class: "survey-response-form" } do |f| %>
            <% @survey.questions.each_with_index do |question, index| %>
              <div class="form-group question-group" data-question-id="<%= question.id %>">
                <label class="form-label">
                  <%= "#{index + 1}. #{question.text}" %>
                  <% if question.required? %>
                    <span class="text-danger">*</span>
                  <% end %>
                </label>

                <% case question.question_type %>
                <% when 'text' %>
                  <textarea 
                    name="response[<%= question.id %>]" 
                    id="response_<%= question.id %>"
                    class="form-control"
                    rows="3"
                    placeholder="Escriba su respuesta aquí..."
                  ></textarea>

                <% when 'multiple_choice' %>
                  <% question.answers.each do |answer| %>
                    <div class="form-check">
                      <input 
                        class="form-check-input" 
                        type="radio" 
                        name="response[<%= question.id %>]" 
                        id="response_<%= question.id %>_<%= answer.id %>"
                        value="<%= answer.id %>"
                      >
                      <label class="form-check-label" for="response_<%= question.id %>_<%= answer.id %>">
                        <%= answer.text %>
                      </label>
                    </div>
                  <% end %>

                <% when 'checkbox' %>
                  <% question.answers.each do |answer| %>
                    <div class="form-check">
                      <input 
                        class="form-check-input" 
                        type="checkbox" 
                        name="response[<%= question.id %>][]" 
                        id="response_<%= question.id %>_<%= answer.id %>"
                        value="<%= answer.id %>"
                      >
                      <label class="form-check-label" for="response_<%= question.id %>_<%= answer.id %>">
                        <%= answer.text %>
                      </label>
                    </div>
                  <% end %>

                <% when 'scale' %>
                  <div class="rating-scale">
                    <% (1..5).each do |value| %>
                      <div class="form-check form-check-inline">
                        <input 
                          class="form-check-input" 
                          type="radio" 
                          name="response[<%= question.id %>]" 
                          id="response_<%= question.id %>_<%= value %>"
                          value="<%= value %>"
                        >
                        <label class="form-check-label" for="response_<%= question.id %>_<%= value %>">
                          <%= value %>
                        </label>
                      </div>
                    <% end %>
                    <small class="text-muted">1 = Muy malo, 5 = Excelente</small>
                  </div>
                <% end %>
              </div>
              <hr>
            <% end %>

            <div class="form-group">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-paper-plane"></i> Enviar Respuestas
              </button>
              <%= link_to "Cancelar", surveys_path, class: "btn btn-secondary" %>
            </div>

            <small class="text-muted">
              <i class="fas fa-info-circle"></i>
              Los campos marcados con <span class="text-danger">*</span> son obligatorios.
            </small>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.question-group.has-error {
  border-left: 3px solid #dc3545;
  padding-left: 15px;
  margin-left: -15px;
}

.rating-scale {
  display: flex;
  align-items: center;
  gap: 10px;
}

.form-check-inline {
  margin-right: 15px;
}

.survey-response-form .form-group {
  margin-bottom: 2rem;
}

.survey-response-form .question-group:last-of-type {
  border-bottom: none;
}

.survey-response-form hr {
  margin: 1.5rem 0;
  border-color: #e9ecef;
}
</style>
