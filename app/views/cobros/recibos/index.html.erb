<% page title: 'Cobros', raiz: 'Administración', hojas: 'Cobros', acciones: [link_to('Nuevo Recibo', new_recibo_path), link_to('Exportar', '#')], id: 'index-recibos' %>
  <div class="row">
    <div class="col-12">
      <div class="card filtros">
        <div class="bg-info" >
          <h4 class="text-white card-title">Filtros<div class="card-actions">
              <a class="" data-action="collapse"><i class="ti-plus"></i></a>
              <a class="btn-close" data-action="close"><i class="ti-close"></i></a>
          </div>
        </h4>
        </div>
        <div class="card-body collapse">
          <%= error_messages_for @query %>
          <%= query_form_for @query, remote: true do |f| %>
            <%= f.input :nro %>
            <%= f.input :emitidos_desde, as: :string, required: false, input_html: { class: 'singledate'} %>
            <%= f.input :emitidos_hasta, as: :string, required: false, input_html: { class: 'singledate'} %>
            <%= f.input :estado, label: 'Estado', as: :select, collection: Logistica::Flujos::EstadoFlujo.all , label_method: :desc, include_blank: true %>
            <%= f.input :horarios_de_corte_ids, as: :select2_local, collection: Clientes::Cuenta.horarios_corte_efectivos(tienda_activa.id), selected: @query.horarios_de_corte_ids, label: 'Hora de Corte', label_method: :to_s, include_blank: true, input_html: {multiple: true}, wrapper_html: { class: "col-sm-9 col-md-4 mb-0"} unless current_user.cliente? %>
            <%= search_buttons f %>
          <% end %>
        </div>
      </div>
      <div class="card">
          <div class="card-header">
              <div class="card-actions">
                <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
              </div>
          </div>
      <span id="recibos-container">
        <%= render 'resultados' %>
      </span>
      </div>
  </div>
</div>
