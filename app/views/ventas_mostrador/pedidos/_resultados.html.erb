<div class="card-body collapse show ajax-data-container">
  <div class="table-responsive">
    <%= table_for @pedidos, id: 'pedidos' do |t| %>
      <% t.column(:codigo, header: 'Detalles', class: 'text-right nowrap', footer: "<span style='white-space: nowrap;font-weight: bold'>Pedidos Totales: <span id='footer-pedidos-count'>...</span></span> ".html_safe) {|x| [(content_tag(:div,link_to(x.codigo, pedido_path(x))) unless x.pendiente?), content_tag(:div, x.created_at), (content_tag(:div, "Autor: #{(x.usuario == x.autor && x.usuario.cliente? ? 'Cliente' : link_to(x.autor.nombre, usuario_path(x.autor)))}".html_safe, class: 'muted small') unless current_user.cliente?)].compact.join.html_safe } %>
      <% t.column(:local, class: 'text-center') if tienda_activa.multiple_locales? %>
      <% t.column(:estado, class: 'text-center') { |c| pedido_estado_label c } %>
      <% t.column(:productos_solicitados, header: 'Productos', class: 'hidden-md-down', footer: "<span style='white-space: nowrap;font-weight: bold'>Productos Totales: <span id='footer-cantidad-total'>...</span></span> ".html_safe) { |t| content_tag(:div,(t.productos_solicitados.map(&:sin_importes).to_a + [("Obs Cliente: #{t.observaciones_cliente}" if t.observaciones_cliente)] + [("Obs Cliente: #{t.observaciones_chef}" if t.observaciones_chef)]).compact.join('<br>').html_safe, class: 'readmoreable') } %>
      <% t.column(:total, header: 'Importe', class: 'text-right') { |t| t.importe_total} %>


      <% t.actions { |t| [edit_pedido_mostrador_link(t), (link_to(content_tag(:i, nil, class: 'ti-printer').html_safe, comprobante_path(t.ultimo_remito, format: :pdf), class: "silentprint", id: "pedido-vmi-#{t.id}", data: {job_type: 'COMPROBANTE', toggle: 'tooltip', "original-title" => 'Imprimir'}) if t.estado_id < 4 && t.ultimo_remito && can?(:export_show, t.ultimo_remito)), (link_to(content_tag(:i, nil, class: 'ti-trash').html_safe, ventas_mostrador_pedido_path(t), method: :delete, data: {confirm: "Está seguro que desea eliminar el pedido #{t.pendiente? ? '' : t.to_s}? El mismo dejará de existir.", toggle: 'tooltip', "original-title" => 'Eliminar' }) if can?(:destroy, t)), (link_to(content_tag(:i, nil, class: 'ti-close').html_safe, cancelar_ventas_mostrador_pedido_path(t), method: :put, data: {confirm: "Está seguro que desea cancelar el pedido #{t.to_s}? El mismo quedará definitivamente en estado Cancelado y sus comprobantes serán anulados con Notas de Crédito.", toggle: 'tooltip', "original-title" => 'Cancelar' }) if can?(:cancelar, t))].compact} %>
    <% end %>
  </div>
</div>
<%= paginador @pedidos, ajax: true %>
